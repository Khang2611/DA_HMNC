# Database Configuration
DB_NAME=vinatrust_bank
DB_USERNAME=USERNAME
DB_PASSWORD=PASSWORD
DB_PORT=5432

# Backend Server Configuration
SERVER_PORT=8080

# JWT Security Configuration
JWT_SECRET=JWT_SECRET
